{
  "name": "@realm/relay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dev": "wrangler dev",
    "deploy:staging": "node --experimental-strip-types --no-warnings scripts/deploy.ts staging",
    "deploy:production": "node --experimental-strip-types --no-warnings scripts/deploy.ts production",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts"
  },
  "//": "Plan 28's relay: a Worker with one Durable Object per Mac. Its tests run in workerd under vitest 4 (what @cloudflare/vitest-pool-workers needs), so this package is outside the root vitest projects and runs as `pnpm relay:test`.",
  "dependencies": { "ws": "^8.18.0" },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.147.0"
  }
}
