{
  "name": "@realm/desktop",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-native.mjs && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "predev": "node scripts/build-native.mjs",
    "dist": "node scripts/stage-pack.mjs && node scripts/pack.mjs --mac dmg zip --publish never",
    "dist:dir": "node scripts/stage-pack.mjs && node scripts/pack.mjs --dir --publish never"
  },
  "dependencies": {
    "emojilib": "4.0.3"
  },
  "devDependencies": {
