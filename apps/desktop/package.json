    "@xterm/xterm": "^5.5.0",
    "cuelume": "^0.2.2",
    "dompurify": "^3.4.13",
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^3.0.0",
    "fast-formula-parser": "^1.0.19",
    "highlight.js": "^11.12.0",
    "jsdom": "^25.0.0",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.1",
