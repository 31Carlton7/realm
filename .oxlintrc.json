{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Oxlint's correctness rules, as errors: CI and the pre-push hook fail on any of them.
  "categories": { "correctness": "error" },
  // The correctness rules the tree does not pass yet. Each is off until the code it flags is cleaned
  // up, and then it goes back on.
  "rules": {
    "no-unused-vars": "off",
    "no-unused-expressions": "off",
    "no-useless-escape": "off",
    "no-control-regex": "off",
    "no-unsafe-optional-chaining": "off",
    "require-yield": "off",
    "no-loss-of-precision": "off",
    "no-eval": "off",
    "no-empty-pattern": "off",
    "no-cond-assign": "off",
    "typescript/no-this-alias": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "unicorn/no-new-array": "off"
  }
}
